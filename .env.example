# ==============================================================================
# Study Buddy AI Agent - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and create a local `.env` file in the root directory:
#      - Windows (PowerShell): copy .env.example .env
#      - macOS / Linux:        cp .env.example .env
# 2. Add your Google Gemini API key below.
# 3. Save the `.env` file.
# 4. NOTE: The `.env` file is in `.gitignore` and must NEVER be committed to GitHub.
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Get your free API key at: https://aistudio.google.com/app/apikey
# Paste your key below (without quotes):
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] OpenAI API Key (Alternative fallback provider)
OPENAI_API_KEY=

# [OPTIONAL] Application Settings
LOG_LEVEL=INFO
DEFAULT_DIFFICULTY=Medium
MAX_FILE_SIZE_MB=200
